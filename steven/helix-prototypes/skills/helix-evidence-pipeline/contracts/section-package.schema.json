{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/section-package/v1",
  "title": "HELIX Section Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "version",
    "section_id",
    "prototype_section_id",
    "title",
    "maturity",
    "promotion_allowed",
    "study_type_ids",
    "depends_on",
    "required_claims",
    "template_contract_gate_ids",
    "skill",
    "output_schema",
    "provenance_policy",
    "study_output_eval_suite",
    "template_conformance_gate_ids",
    "retry_policy",
    "drafting_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.section-package/v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^section\\.[a-z0-9_]+$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "prototype_section_id": {
      "type": ["string", "null"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "enum": ["vertical_slice", "complete"]
    },
    "promotion_allowed": {
      "type": "boolean"
    },
    "study_type_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_selector", "grain", "required"],
        "properties": {
          "claim_selector": {
            "type": "string",
            "minLength": 1
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "template_contract_gate_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "promptfoo_suite", "qualification_status"],
      "properties": {
        "name": {
          "const": "helix-section-agent"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "promptfoo_suite": {
          "$ref": "#/$defs/versionedAsset"
        },
        "qualification_status": {
          "enum": ["pending", "passed", "failed"]
        },
        "qualification_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "provenance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_factual_span_claims", "require_table_cell_claims"],
      "properties": {
        "require_factual_span_claims": {
          "const": true
        },
        "require_table_cell_claims": {
          "const": true
        }
      }
    },
    "study_output_eval_suite": {
      "$ref": "#/$defs/versionedAsset"
    },
    "template_conformance_gate_ids": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts_per_cycle"],
      "properties": {
        "max_attempts_per_cycle": {
          "const": 3
        }
      }
    },
    "drafting_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "forbidden_claims"],
      "properties": {
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "maturity": {
            "const": "vertical_slice"
          }
        }
      },
      "then": {
        "properties": {
          "promotion_allowed": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "versionedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
