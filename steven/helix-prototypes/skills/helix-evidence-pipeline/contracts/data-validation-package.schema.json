{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/data-validation-package/v1",
  "title": "HELIX Data Validation Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "version",
    "node_id",
    "domain",
    "depends_on",
    "inputs",
    "agentic_skill",
    "executors",
    "rules",
    "outputs",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.data-validation-package/v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^validation\\.[a-z0-9_]+$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_kinds", "record_schema"],
        "properties": {
          "artifact_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "record_schema": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agentic_skill": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/skill"
        }
      ]
    },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/versionedIdentifier"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "rule_version", "enforcement_class"],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "$ref": "#/$defs/semver"
          },
          "enforcement_class": {
            "enum": ["hard_blocker", "review_required", "warning"]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_type", "grain"],
        "properties": {
          "claim_type": {
            "type": "string",
            "minLength": 1
          },
          "grain": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_paths"],
      "properties": {
        "fixture_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "versionedIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "promptfoo_suite", "qualification_status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "promptfoo_suite": {
          "$ref": "#/$defs/versionedAsset"
        },
        "qualification_status": {
          "enum": ["pending", "passed", "failed"]
        },
        "qualification_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "versionedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
