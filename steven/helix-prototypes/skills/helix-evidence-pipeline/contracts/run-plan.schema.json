{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/run-plan/v1",
  "title": "HELIX Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_plan_id",
    "run_id",
    "version",
    "fingerprint",
    "created_at",
    "manifest_hash",
    "governed_versions",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.run-plan/v1"
    },
    "run_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "governed_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "depends_on",
          "input_fingerprint",
          "status",
          "evidence"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "parse",
              "study_type_resolution",
              "data_validation",
              "template_contract",
              "section_agent",
              "provenance",
              "study_output_evaluation",
              "template_conformance",
              "section_promotion",
              "review_scaffold"
            ]
          },
          "package_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "package_version": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_fingerprint": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "enum": [
              "pending",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "subject",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
