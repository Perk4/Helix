{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/section-execution-envelope/v1",
  "title": "HELIX Section Execution Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "run_id",
    "pinned_run_id",
    "run_plan_hash",
    "manifest_hash",
    "section_package",
    "direct_dependencies",
    "validated_claims",
    "study_context",
    "structured_failures",
    "executor_receipts",
    "governed_versions"
  ],
  "properties": {
    "schema_version": {
      "const": "helix.section-execution-envelope/v1"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "pinned_run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "section_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "version",
        "path",
        "hash"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "direct_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "validated_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "field_id",
          "value",
          "unit",
          "grain",
          "hash"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "study_context": {
      "type": "object"
    },
    "structured_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "code",
          "message"
        ],
        "properties": {
          "result_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executor_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executorReceipt"
      }
    },
    "governed_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_drafts": {
      "type": "array",
      "description": "Approved sections from earlier studies, supplied as style exemplars. They carry no claim authority: they come from a different study, and every value in them belongs to that study. The agent may follow their structure and wording and must take no number from them. Only validated_claims and executor_receipts supply values.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id",
          "section_title",
          "hash",
          "content"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "section_title": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "$ref": "#/$defs/sha256"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "hash"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executorReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "hash"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "facts": {
          "type": "object",
          "description": "Values the deterministic executor computed for this section. The agent renders these; it never recalculates them."
        },
        "provenance": {
          "type": "array",
          "description": "Source records behind each computed value, per ADR-0013.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "claim",
              "source_record_ids",
              "agg"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "source_record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "agg": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
