POSTGRES_DB=helix
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix-local-only
HELIX_DATABASE_URL=postgresql+psycopg://helix:helix-local-only@db:5432/helix
HELIX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HELIX_AUTO_SEED=true
HELIX_SEED_PATH=synthetic-e2e/helix-synthetic-bundle.json
HELIX_LLM_BASE_URL=https://lgts1tetamoai01.openai.azure.com/openai/v1
HELIX_LLM_MODEL=gpt-5.5
HELIX_LLM_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://lgts1tetamoai01.openai.azure.com/openai/v1
OPENAI_MODEL=gpt-5.5
LLM_MODEL=gpt-5.5
LLM_API_BASE=https://lgts1tetamoai01.openai.azure.com/openai/v1
# --- Promptfoo eval runner (tier-1 skill qualification) -----------------------
# `npm run evals` reads these. Values below are the endpoint verified working
# against this subscription key: the APIM gateway, `api-key` header auth, and
# the Azure deployments path. Promptfoo builds the request URL as
#   ${AZURE_OPENAI_API_BASE_URL}/openai/deployments/<deployment>/chat/completions?api-version=${AZURE_API_VERSION}
# so AZURE_OPENAI_API_BASE_URL stops one segment short of `/openai`.
HELIX_PROMPTFOO_PROVIDER=azureopenai:chat:gpt-5.5
AZURE_OPENAI_API_BASE_URL=https://lgts1tetamapi01.azure-api.net/gpt51
AZURE_API_VERSION=2024-10-21
# Same subscription key as HELIX_LLM_API_KEY. Promptfoo reads AZURE_API_KEY, so
# export one from the other rather than storing the secret twice.
AZURE_API_KEY=
